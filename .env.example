# =========================================================
# Handyman API — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# =========================================================

# Ruta al archivo de credenciales de Firebase Admin SDK
SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Orígenes permitidos para CORS (formato JSON array)
CORS_ORIGINS=["http://localhost:8100","capacitor://localhost","http://localhost"]

# Umbral de distancia coseno para reconocimiento facial (0.0–1.0)
# Menor = más estricto. Valor recomendado: 0.40
UMBRAL_FACIAL=0.40

# Tamaño máximo de imágenes en bytes (por defecto 5 MB)
MAX_IMAGEN_BYTES=5242880

# Intentos máximos de verificación facial por usuario por hora
INTENTOS_MAX_POR_HORA=5

# API key web del proyecto Firebase (Consola → Configuración del proyecto).
# Si está vacía, POST /usuarios/cuenta igual crea Auth + Firestore, pero no devuelve idToken.
FIREBASE_WEB_API_KEY=
